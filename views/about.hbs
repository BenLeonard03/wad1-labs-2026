{{> menu id="about"}}

<section class="ui segment">
  <h2 class="ui header">Development Team</h2>

  <div class="ui three stackable cards">
    {{#each employees}}
      <div class="card">
        <div class="image">
          <img src="{{image}}" alt="{{fullname}}">
        </div>
        <div class="content">
          <a class="header">{{fullname}}</a>
          <div class="meta">{{job}}</div>
          <div class="description">
            Based in {{city}}, joined in {{joined}}.  
            Works with {{mates}} teammates.
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</section>

